# Copy to .env. Existing shell environment variables take precedence.
AWS_REGION=us-east-1

# Recommended: use an AWS CLI/SSO profile. Leave commented for the default
# credential chain (environment credentials, default profile, or AWS role).
# AWS_PROFILE=hackathon
# Alternative: temporary credentials supplied by your hackathon account.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Shared model for all text-agent roles. This profile routes across US Regions.
BEDROCK_LLM_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Explicit role mappings. These currently reuse one Sonnet inference profile,
# while allowing a role to move to another approved model later.
BEDROCK_DECOMPOSITION_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_CLASSIFICATION_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_ROUTING_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_SPECIALIST_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_LAB_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_RADIOLOGY_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_ECG_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_QUERY_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_EVALUATION_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_RECOVERY_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_DOCTOR_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_NUTRITION_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_PHYSIO_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_GUIDANCE_REVIEW_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_GENERATION_MODEL_ID=us.anthropic.claude-sonnet-4-6

BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
BEDROCK_RERANK_MODEL_ID=cohere.rerank-v3-5:0
# Optional ARN override; otherwise derived from AWS_REGION and model ID.
# BEDROCK_RERANK_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/cohere.rerank-v3-5:0

# Layer 00 graph extraction: this Bedrock Runtime Converse profile is the
# working starting choice. The architecture's preferred GPT-6 Sol is a separate
# endpoint compatibility test; do not substitute its Mantle ID here.
GRAPH_MODEL_ID=us.anthropic.claude-sonnet-4-6
# After a successful Converse test only: GRAPH_MODEL_ID=us.openai.gpt-6-sol

# Deployed 2026-10-23 demo: one Bedrock KB backed by Neptune Analytics.
# These IDs are resource references, not credentials; they do not provision anything.
INGESTION_MODE=managed_neptune_graphrag
BEDROCK_KNOWLEDGE_BASE_ID=L5QSI6FVDY
NEPTUNE_ANALYTICS_GRAPH_ID=g-qvfjw4p3qa
S3_BUCKET=awshackathon2026
S3_REFERENCE_PREFIX=sample-data/s3/reference/
S3_PATIENT_PREFIX=sample-data/s3/patient/
S3_EVALUATION_PREFIX=evaluation
S3_GRAPH_IMPORT_PREFIX=graph-import

# Layers 01-05 retrieval. Managed mode uses the Layer 00 Bedrock Knowledge Base;
# local mode scans the checked-in reference fixtures for offline development.
WORKFLOW_RETRIEVAL_MODE=managed
WORKFLOW_MODEL_MODE=bedrock
WORKFLOW_DATA_DIR=.runtime
BEDROCK_KB_REFERENCE_URI_PREFIX=s3://awshackathon2026/sample-data/s3/reference/
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# The following settings belong only to the optional custom OpenSearch +
# Neptune Database export path; they are unused by the managed demo.
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX_PREFIX=health-reference
NEPTUNE_ENDPOINT=
NEPTUNE_PORT=8182
NEPTUNE_LOAD_ROLE_ARN=

# Textract is a service, not a model ID. Use only for scanned documents/tables.
TEXTRACT_REGION=us-east-1
