e=20;fontColor=#17243A;spacing=8;" vertex="1" parent="1"><mxGeometry x="135" y="1580" width="365" height="100" as="geometry"/></mxCell><mxCell id="traverse" value="Graph traversal&#xa;Start 1-2 hops; cap at 5&#xa;Allowlist / cycle / size limits" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E6F3F1;strokeColor=#4D978E;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#17243A;spacing=8;" vertex="1" parent="1"><mxGeometry x="635" y="1580" width="370" height="100" as="geometry"/></mxCell><mxCell id="rerank" value="Cohere Rerank 3.5&#xa;Merged real-source candidates&#xa;Relevance is not confidence" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F0E8FC;strokeColor=#8B5FC7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#17243A;spacing=8;" vertex="1" parent="1"><mxGeometry x="1145" y="1580" width="370" height="100" as="geometry"/></mxCell><mxCell id="expand" value="Expand parent context&#xa;Preserve qualifiers / provenance&#xa;Validate citation IDs" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF1FB;strokeColor=#6D91C9;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#17243A;spacing=8;" vertex="1" parent="1"><mxGeometry x="1145" y="1780" width="370" height="90" as="geometry"/></mxCell><mxCell id="package" value="EvidencePackage per worker&#xa;Observations / interpretations&#xa;Citations / conflicts / gaps / status" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E6F3F1;strokeColor=#4D978E;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#17243A;spacing=8;" vertex="1" parent="1"><mxGeometry x="635" y="1780" width="370" height="100" as="geometry"/></mxCell><mxCell id="gather" value="LangGraph gather + reducer&#xa;Keep completed / partial / failed&#xa;Immutable, versioned records" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF1FB;strokeColor=#6D91C9;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#17243A;spacing=8;" vertex="1" parent="1"><mxGeometry x="135" y="1780" width="365" height="100" as="geometry"/></mxCell><mxCell id="ontology" value="OPTIONAL ontology checks&#xa;Entity / relation / unit constraints&#xa;Not proof of clinical correctness" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF2DC;strokeColor=#CD9648;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#17243A;spacing=8;" vertex="1" parent="1"><mxGeometry x="1145" y="1910" width="370" height="75" as="geometry"/></mxCell><mxCell id="recover" value="Bounded retrieval recovery&#xa;Sonnet: paraphrase + step-back&#xa;+ &lt;=150-word HyDE in one call&#xa;HyDE is search-only, never evidence" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F0E8FC;strokeColor=#8B5FC7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#17243A;spacing=8;" vertex="1" parent="1"><mxGeometry x="1710" y="1300" width="365" height="135" as="geometry"/></mxCell><mxCell id="recoverygate" value="Runtime recovery gate&#xa;Grant remains + retrieval gap?&#xa;Missing patient fact -&gt; clarify&#xa;Red flag -&gt; human review" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EDF5E8;strokeColor=#71A266;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#17243A;spacing=8;" vertex="1" parent="1"><mxGeometry x="1710" y="1530" width="365" height="130" as="geometry"/></mxCell><mxCell id="doctor" value="Sonnet Doctor synthesis&#xa;Review combined specialist state&#xa;Claim support / conflicts / gaps" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F0E8FC;strokeColor=#8B5FC7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#17243A;spacing=8;" vertex="1" parent="1"><mxGeometry x="135" y="2130" width="365" height="105" as="geometry"/></mxCell><mxCell id="decision" value="Evidence / safety&#xa;gate" style="rhombus;whiteSpace=wrap;html=0;fillColor=#EDF5E8;strokeColor=#71A266;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#17243A;spacing=8;" vertex="1" parent="1"><mxGeometry x="665" y="2115" width="310" height="130" as="geometry"/></mxCell><mxCell id="pause" value="Clarify / human-review pause&#xa;Missing context, unresolved flags&#xa;Withhold dependent care guidance" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF2DC;strokeColor=#CD9648;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#17243A;spacing=8;" vertex="1" parent="1"><mxGeometry x="1145" y="2130" width="370" height="105" as="geometry"/></mxCell><mxCell id="nutrition" value="Nutrition worker: Nova Pro&#xa;Scoped foods / living-with KB&#xa;Reviewed findings + restrictions" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F0E8FC;strokeColor=#8B5FC7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#17243A;spacing=8;" vertex="1" parent="1"><mxGeometry x="150" y="2350" width="370" height="100" as="geometry"/></mxCell><mxCell id="physio" value="Physio worker: Nova Pro&#xa;Scoped activity / living-with KB&#xa;Reviewed findings + restrictions" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F0E8FC;strokeColor=#8B5FC7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#17243A;spacing=8;" vertex="1" parent="1"><mxGeometry x="665" y="2350" width="370" height="100" as="geometry"/></mxCell><mxCell id="guidance" value="Sonnet guidance support check&#xa;New claims need supporting sources&#xa;No unsupported personalized plans" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F0E8FC;strokeColor=#8B5FC7;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#17243A;spacing=8;" vertex="1" parent="1"><mxGeometry x="1165" y="2350" width="370" height="100" as="geometry"/></mxCell><mxCell id="bundle" value="ReviewedContentBundle&#xa;Supported claims + guidance&#xa;Limitations / citations / review status" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E6F3F1;strokeColor=#4D978E;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#17243A;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="2670" width="335" height="105" as="geometry"/></mxCell><mxCell id="generation" value="Sonnet final generation&#xa;Plain-language explanation&#xa;No new clinical conclusions" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F0E8FC;strokeColor=#8B5FC7;strokeWid