ub" value="Observations drive shared retrieval, then evidence returns to the Doctor" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=23;fontColor=#17243A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="52" y="93" width="1175" height="38" as="geometry"/></mxCell><mxCell id="analyze" value="Specialist model&#xa;Extract observations" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F0E8FC;strokeColor=#8B5FC7;strokeWidth=1.5;fontFamily=Arial;fontSize=22;fontColor=#17243A;spacing=10;" vertex="1" parent="1"><mxGeometry x="55" y="180" width="270" height="90" as="geometry"/></mxCell><mxCell id="query" value="Construct query&#xa;Observed facts + need" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF1FB;strokeColor=#6D91C9;strokeWidth=1.5;fontFamily=Arial;fontSize=22;fontColor=#17243A;spacing=10;" vertex="1" parent="1"><mxGeometry x="360" y="180" width="270" height="90" as="geometry"/></mxCell><mxCell id="search" value="OpenSearch hybrid&#xa;Keyword + vector + RRF" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E6F3F1;strokeColor=#4D978E;strokeWidth=1.5;fontFamily=Arial;fontSize=22;fontColor=#17243A;spacing=10;" vertex="1" parent="1"><mxGeometry x="665" y="180" width="270" height="90" as="geometry"/></mxCell><mxCell id="rerank" value="Cohere Rerank 3.5&#xa;Real source candidates" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F0E8FC;strokeColor=#8B5FC7;strokeWidth=1.5;fontFamily=Arial;fontSize=22;fontColor=#17243A;spacing=10;" vertex="1" parent="1"><mxGeometry x="970" y="180" width="270" height="90" as="geometry"/></mxCell><mxCell id="graph" value="Graph search&#xa;Start 1–2 hops; cap 5" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E6F3F1;strokeColor=#4D978E;strokeWidth=1.5;fontFamily=Arial;fontSize=22;fontColor=#17243A;spacing=10;" vertex="1" parent="1"><mxGeometry x="350" y="365" width="300" height="85" as="geometry"/></mxCell><mxCell id="parent" value="Expand parent context&#xa;Preserve source offsets" s